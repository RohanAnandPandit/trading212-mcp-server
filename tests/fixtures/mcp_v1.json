            "type": "integer"
          }
        },
        "required": [
          "pie_id"
        ],
        "title": "delete_pieArguments",
        "type": "object"
      }
    },
    {
      "name": "fetch_a_pie",
      "description": "Fetch a specific pie by ID.",
      "inputSchema": {
        "properties": {
