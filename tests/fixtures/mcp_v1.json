    {
      "name": "place_limit_order",
      "description": "\n    Place a limit order to buy or sell an instrument at a specified price or better.\n\n    Args:\n        ticker: Ticker symbol of the instrument to trade (e.g., 'AAPL_US_EQ')\n        quantity: Number of shares/units to trade\n        limit_price: Limit price for the order\n        time_validity: Time validity of the order. Defaults to DAY.\n            Possible values: DAY, GOOD_TILL_CANCEL\n\n    Returns:\n        Order: Details of the placed order\n    ",
      "inputSchema": {
        "$defs": {
          "LimitRequestTimeValidityEnum": {
            "enum": [
              "DAY",
              "GOOD_TILL_CANCEL"
            ],
            "title": "LimitRequestTimeValidityEnum",
            "type": "string"
          }
        },
        "properties": {
          "ticker": {
            "title": "Ticker",
            "type": "string"
          },
          "quantity": {
            "title": "Quantity",
            "type": "number"
          },
          "limit_price": {
            "title": "Limit Price",
            "type": "number"
          },
          "time_validity": {
            "$ref": "#/$defs/LimitRequestTimeValidityEnum",
            "default": "DAY"
          }
        },
        "required": [
          "ticker",
          "quantity",
          "limit_price"
        ],
        "title": "place_limit_orderArguments",
        "type": "object"
      }
    },
    {
      "name": "place_market_order",
      "description": "\n    Place a market order to buy or sell an instrument at the current market price.\n\n    Args:\n        ticker: Ticker symbol of the instrument to trade (e.g., 'AAPL_US_EQ')\n        quantity: Number of shares/units to trade\n        extended_hours: Whether the order can execute outside regular trading\n            hours when the instrument supports it\n\n    Returns:\n        Order: Details of the placed order\n    ",
      "inputSchema": {
        "properties": {
          "ticker": {
            "title": "Ticker",
            "type": "string"
          },
          "quantity": {
            "title": "Quantity",
            "type": "number"
          },
          "extended_hours": {
            "default": false,
            "title": "Extended Hours",
            "type": "boolean"
          }
        },
        "required": [
          "ticker",
          "quantity"
        ],
        "title": "place_market_orderArguments",
        "type": "object"
      }
    },
    {
      "name": "place_stop_order",
      "description": "\n    Place a stop order to buy or sell an instrument when the market price\n    reaches a specified stop price.\n\n    Args:\n        ticker: Ticker symbol of the instrument to trade (e.g., 'AAPL_US_EQ')\n        quantity: Number of shares/units to trade\n        stop_price: Stop price that triggers the order\n        time_validity: Time validity of the order. Defaults to DAY.\n            Possible values: DAY, GOOD_TILL_CANCEL\n\n    Returns:\n        Order: Details of the placed order\n    ",
      "inputSchema": {
        "$defs": {
          "StopRequestTimeValidityEnum": {
            "enum": [
              "DAY",
              "GOOD_TILL_CANCEL"
            ],
            "title": "StopRequestTimeValidityEnum",
            "type": "string"
          }
        },
        "properties": {
          "ticker": {
            "title": "Ticker",
            "type": "string"
          },
          "quantity": {
            "title": "Quantity",
            "type": "number"
          },
          "stop_price": {
            "title": "Stop Price",
            "type": "number"
          },
          "time_validity": {
            "$ref": "#/$defs/StopRequestTimeValidityEnum",
            "default": "DAY"
          }
        },
        "required": [
          "ticker",
          "quantity",
          "stop_price"
        ],
        "title": "place_stop_orderArguments",
        "type": "object"
      }
    },
    {
      "name": "place_stop_limit_order",
      "description": "\n    Place a stop-limit order to buy or sell an instrument when the market\n    price reaches a specified stop price, then execute at a specified limit\n    price or better.\n\n    Args:\n        ticker: Ticker symbol of the instrument to trade (e.g., 'AAPL_US_EQ')\n        quantity: Number of shares/units to trade\n        stop_price: Stop price that triggers the limit order\n        limit_price: Limit price for the order\n        time_validity: Time validity of the order. Defaults to DAY.\n            Possible values: DAY, GOOD_TILL_CANCEL\n\n    Returns:\n        Order: Details of the placed order\n    ",
      "inputSchema": {
        "$defs": {
          "StopLimitRequestTimeValidityEnum": {
            "enum": [
              "DAY",
              "GOOD_TILL_CANCEL"
            ],
            "title": "StopLimitRequestTimeValidityEnum",
            "type": "string"
          }
        },
        "properties": {
          "ticker": {
            "title": "Ticker",
            "type": "string"
          },
          "quantity": {
            "title": "Quantity",
            "type": "number"
          },
          "stop_price": {
            "title": "Stop Price",
            "type": "number"
          },
          "limit_price": {
            "title": "Limit Price",
            "type": "number"
          },
          "time_validity": {
            "$ref": "#/$defs/StopLimitRequestTimeValidityEnum",
            "default": "DAY"
          }
        },
        "required": [
          "ticker",
          "quantity",
          "stop_price",
          "limit_price"
        ],
        "title": "place_stop_limit_orderArguments",
        "type": "object"
      }
