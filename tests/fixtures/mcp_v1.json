{
  "tools": [
    {
      "name": "search_instrument",
      "description": "\n    Fetch instruments, optionally filtered by ticker or name.\n\n    Args:\n        search_term: Search term to filter instruments by ticker or name\n        (case-insensitive)\n\n    Returns:\n        List of matching TradeableInstrument objects, or all instruments if no\n        search term is provided\n    ",
      "inputSchema": {
        "properties": {
          "search_term": {
            "default": null,
            "title": "Search Term",
            "type": "string"
          }
        },
        "title": "search_instrumentArguments",
        "type": "object"
      }
    },
    {
      "name": "search_exchange",
      "description": "\n    Fetch exchanges, optionally filtered by name or ID.\n\n    Args:\n        search_term: Optional search term to filter exchanges by name or ID\n        (case-insensitive)\n\n    Returns:\n        List of matching Exchange objects, or all exchanges if no search term\n        is provided\n    ",
      "inputSchema": {
        "properties": {
          "search_term": {
            "default": null,
            "title": "Search Term",
            "type": "string"
          }
        },
        "title": "search_exchangeArguments",
        "type": "object"
      }
    },
    {
      "name": "fetch_pies",
      "description": "Fetch all pies.",
      "inputSchema": {
        "properties": {},
        "title": "fetch_piesArguments",
        "type": "object"
      }
    },
    {
      "name": "create_pie",
      "description": "\n    Create a new pie with the specified parameters.\n\n    Args:\n        name: Name of the pie\n        instrument_shares: Dictionary mapping instrument tickers to their\n        weights in the pie\n            (e.g., {'AAPL_US_EQ': 0.5, 'MSFT_US_EQ': 0.5})\n        dividend_cash_action: How dividends are handled. Defaults to REINVEST.\n            Possible values: REINVEST, TO_ACCOUNT_CASH\n        end_date: Optional end date for the pie in ISO 8601 format\n            (e.g., '2024-12-31T23:59:59Z')\n        goal: Total desired value of the pie in account currency\n        icon: Optional icon identifier for the pie\n\n    Returns:\n        AccountBucketInstrumentsDetailedResponse: Details of the created pie\n    ",
      "inputSchema": {
        "$defs": {
          "DividendCashActionEnum": {
            "enum": [
              "REINVEST",
              "TO_ACCOUNT_CASH"
            ],
            "title": "DividendCashActionEnum",
            "type": "string"
          }
        },
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "instrument_shares": {
            "additionalProperties": {
              "type": "number"
            },
            "title": "Instrument Shares",
            "type": "object"
          },
          "dividend_cash_action": {
            "anyOf": [
              {
                "$ref": "#/$defs/DividendCashActionEnum"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "end_date": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "End Date"
          },
          "goal": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Goal"
          },
          "icon": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Icon"
          }
        },
        "required": [
          "name",
          "instrument_shares"
        ],
        "title": "create_pieArguments",
        "type": "object"
      }
    },
    {
      "name": "delete_pie",
      "description": "Delete a pie.",
      "inputSchema": {
        "properties": {
