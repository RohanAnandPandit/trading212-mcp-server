    {
      "name": "request_csv_export",
      "description": "\n    Request a CSV export of the account's orders, dividends and transactions\n    history.\n    Once the export is complete it can be accessed from the download link in the\n     exports list.\n\n    Args:\n        include_dividends: Whether to include dividend information in the export.\n            Defaults to True\n        include_interest: Whether to include interest information in the export.\n        Defaults to True\n        include_orders: Whether to include order history in the export.\n        Defaults to True\n        include_transactions: Whether to include transaction history in the export.\n        Defaults to True\n        time_from: Start time for the report in ISO 8601 format\n        (e.g., '2023-01-01T00:00:00Z')\n        time_to: End time for the report in ISO 8601 format\n        (e.g., '2023-12-31T23:59:59Z')\n\n    Returns:\n        EnqueuedReportResponse: Response containing the report ID and status\n    ",
      "inputSchema": {
        "properties": {
          "include_dividends": {
            "default": true,
            "title": "Include Dividends",
            "type": "boolean"
          },
          "include_interest": {
            "default": true,
            "title": "Include Interest",
            "type": "boolean"
          },
          "include_orders": {
            "default": true,
            "title": "Include Orders",
            "type": "boolean"
          },
          "include_transactions": {
            "default": true,
            "title": "Include Transactions",
            "type": "boolean"
          },
          "time_from": {
            "default": null,
            "title": "Time From",
            "type": "string"
          },
          "time_to": {
            "default": null,
            "title": "Time To",
            "type": "string"
          }
        },
        "title": "request_csv_exportArguments",
        "type": "object"
      }
