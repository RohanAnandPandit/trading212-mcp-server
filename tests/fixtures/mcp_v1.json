            "type": "integer"
          }
        },
        "required": [
          "pie_id"
        ],
        "title": "fetch_a_pieArguments",
        "type": "object"
      }
    },
    {
      "name": "update_pie",
      "description": "\n    Update an existing pie with new parameters. The pie must be renamed when\n    updating it.\n\n    Args:\n        pie_id: ID of the pie to update\n        name: New name for the pie. Required when updating a pie.\n        instrument_shares: Dictionary mapping instrument tickers to their new\n        weights in the pie\n            (e.g., {'AAPL_US_EQ': 0.5, 'MSFT_US_EQ': 0.5})\n        dividend_cash_action: How dividends should be handled.\n            Possible values: REINVEST, TO_ACCOUNT_CASH\n        end_date: New end date for the pie in ISO 8601 format\n            (e.g., '2024-12-31T23:59:59Z')\n        goal: New total desired value of the pie in account currency\n        icon: New icon identifier for the pie\n\n    Returns:\n        AccountBucketInstrumentsDetailedResponse: Updated details of the pie\n    ",
      "inputSchema": {
        "$defs": {
          "DividendCashActionEnum": {
            "enum": [
              "REINVEST",
              "TO_ACCOUNT_CASH"
            ],
            "title": "DividendCashActionEnum",
            "type": "string"
          }
        },
        "properties": {
          "pie_id": {
            "title": "Pie Id",
            "type": "integer"
          },
          "name": {
            "default": null,
            "title": "Name",
            "type": "string"
          },
          "instrument_shares": {
            "additionalProperties": {
              "type": "number"
            },
            "default": null,
            "title": "Instrument Shares",
            "type": "object"
          },
          "dividend_cash_action": {
            "anyOf": [
              {
                "$ref": "#/$defs/DividendCashActionEnum"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "end_date": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "End Date"
          },
          "goal": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Goal"
          },
          "icon": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Icon"
          }
        },
        "required": [
          "pie_id"
        ],
        "title": "update_pieArguments",
        "type": "object"
      }
    },
    {
      "name": "duplicate_pie",
      "description": "\n    Create a duplicate of an existing pie.\n\n    Args:\n        pie_id: ID of the pie to duplicate\n        name: Optional new name for the duplicated pie\n        icon: Optional new icon for the duplicated pie\n\n    Returns:\n        AccountBucketInstrumentsDetailedResponse: Details of the duplicated pie\n    ",
      "inputSchema": {
        "properties": {
          "pie_id": {
            "title": "Pie Id",
            "type": "integer"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Name"
          },
          "icon": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Icon"
          }
        },
        "required": [
          "pie_id"
        ],
        "title": "duplicate_pieArguments",
        "type": "object"
